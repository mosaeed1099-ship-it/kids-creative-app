# Cloudflare Pages — HTTP response headers for Kids Creative Studio
# https://developers.cloudflare.com/pages/configuration/headers/

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML entry: always revalidate so new releases are picked up immediately.
/index.html
  Cache-Control: no-cache

# Manifest: revalidate.
/manifest.webmanifest
  Cache-Control: no-cache

# App code — not fingerprinted, so keep the window short (1 hour).
/js/*
  Cache-Control: public, max-age=3600
/css/*
  Cache-Control: public, max-age=3600

# Brand/static art — changes rarely (1 day).
/assets/*
  Cache-Control: public, max-age=86400
