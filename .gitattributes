# Normalize line endings across platforms.
* text=auto eol=lf

# Explicit text types (kept LF so Cloudflare + browsers parse consistently).
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.webmanifest text eol=lf

# Binary assets (never touch EOLs).
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
*.mp3    binary
*.wav    binary
